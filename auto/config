#!/bin/sh
# Configuracao do live-build para a ISO Live (Debian 13 + XFCE).
# NAO EXECUTADO ainda: validar com `lb config` em Debian 13 (live-build 1:20250505).
# Referencia: Debian Live Manual e `man lb_config`.
#
# Decisoes (docs/architecture.md):
#  - somente main + non-free-firmware (sem contrib/non-free);
#  - --apt-recommends false: so entra o que as listas pedem (D-007);
#  - sem debian-installer: o instalador e o Calamares (lista 40-installer, D-013);
#  - idioma/teclado/fuso via parametros de boot do live-config.

set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main non-free-firmware" \
	--mirror-bootstrap "https://deb.debian.org/debian/" \
	--mirror-chroot "https://deb.debian.org/debian/" \
	--mirror-binary "https://deb.debian.org/debian/" \
	--security true \
	--updates true \
	--backports false \
	--source false \
	--firmware-chroot true \
	--firmware-binary true \
	--linux-flavours amd64 \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--debian-installer none \
	--win32-loader false \
	--memtest none \
	--checksums sha256 \
	--apt-recommends false \
	--iso-application "Maska OS" \
	--iso-publisher "Maska OS project; nao oficial: Debian, Kali ou Linux Mint" \
	--iso-volume "MASKA_OS" \
	--bootappend-live "boot=live components quiet username=maska hostname=maska locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo" \
	"${@}"
