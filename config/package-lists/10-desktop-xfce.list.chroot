# 10 - Desktop XFCE sem metapacotes amplos (nao usar: xfce4, xfce4-goodies, task-xfce-desktop, xorg).
# Motivo: esses metapacotes puxam Recommends e plugins que nao sao necessarios; ver docs/architecture.md D-007.

# Servidor grafico minimo (driver modesetting ja vem no xserver-xorg-core)
xserver-xorg-core
xserver-xorg-input-libinput

# Login
lightdm
lightdm-gtk-greeter

# Nucleo XFCE
xfce4-session
xfwm4
xfce4-panel
xfdesktop4
xfce4-settings
xfce4-appfinder
xfce4-whiskermenu-plugin
xfce4-notifyd
xfce4-power-manager
xfce4-xkb-plugin
xfce4-pulseaudio-plugin
xfce4-terminal
xfce4-screenshooter
xfce4-screensaver
xfce4-taskmanager
mousepad
ristretto

# Arquivos, midia removivel e miniaturas
thunar
thunar-volman
thunar-archive-plugin
xarchiver
tumbler
gvfs
gvfs-fuse
udisks2

# Rede, audio e Bluetooth na bandeja
network-manager-gnome
pipewire-audio
pavucontrol
bluez
blueman
libspa-0.2-bluetooth

# Autorizacao grafica e sessao. mate-polkit inicia no XFCE (NotShowIn=GNOME;KDE);
# lxpolkit NAO serve: seu autostart tem NotShowIn=...XFCE (lxsession 0.5.6)
polkitd
pkexec
mate-polkit
dbus-user-session
dbus-x11
at-spi2-core
xdg-user-dirs
xdg-utils

# Aparencia: tema com variantes clara/escura (Greybird, Greybird-dark) e fonte base
greybird-gtk-theme
adwaita-icon-theme
fonts-dejavu-core
fonts-liberation
